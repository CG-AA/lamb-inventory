###
# pyenv
###
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
# guarded: pyenv is a per-machine install; unguarded this errors on every shell
# start on hosts without it. The `bash` flavour arg (and the `complete`/
# PROMPT_COMMAND block below) are harmless under zsh, which simply ignores them.
command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init - bash)"

###
# PATH ~/.local/bin
###
export PATH="$HOME/.local/bin:$PATH"
###
# PATH cargo
###
export PATH="$HOME/.cargo/bin:$PATH"

###
# npx gemini
###
alias gemini='npx @google/gemini-cli '

###
# mount btrfs subvolume
# mount-subvol [subvol] [device] [mount point]
###
mount-subvol() {
    sudo mount -o subvol="$1" "$2" "$3"
}

###
# alias sudo s
###
alias s='sudo '
# Define a setup function to clone the completion rule
_setup_s_alias_completion() {
    # Force bash to load whatever rules it actually uses for sudo
    _completion_loader sudo 2>/dev/null

    # Fetch the exact rule Bash assigned to sudo (e.g., "complete -F _command sudo")
    local sudo_rule=$(complete -p sudo 2>/dev/null)

    # If successfully grabbed, replace the word 'sudo' at the end with 's' and apply it
    if [[ -n "$sudo_rule" ]]; then
        eval "${sudo_rule/%sudo/s}"
    fi

    # Overwrite this function with a no-op so it only executes once to save resources
    _setup_s_alias_completion() { :; }
}

# Append to PROMPT_COMMAND so it runs exactly once, right before your first terminal prompt appears
PROMPT_COMMAND="_setup_s_alias_completion${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
