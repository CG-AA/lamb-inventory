# ~/.shell_common — sourced by both .bashrc and .zshrc
# Keep ONLY shell-agnostic content here (aliases, exports, PATH).
# Shell-specific config (prompt, completion, keybindings) lives in
# the respective rc file.

# ---- PATH ----
# Prepend personal bins if they exist (guard so we don't add junk).
[ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH"
[ -d "$HOME/bin" ]        && PATH="$HOME/bin:$PATH"
export PATH

# ---- ls / grep colors ----
# `dircolors -b` emits sh-compatible syntax, so both shells eval it fine.
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# ---- ls shortcuts ----
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# ---- navigation shortcuts (handy, portable) ----
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

