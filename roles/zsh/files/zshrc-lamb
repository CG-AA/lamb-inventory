# ~/.zshrc-lamb — the zsh interactive config. Managed by Ansible (roles/zsh,
# lamb-inventory): edit the copy in roles/zsh/files/, not this one — the role
# overwrites it. Your OWN ~/.zshrc stays yours; it only carries the marker
# block that sources this file (keep that block last there, see below).

# ---- shared, portable layer first: PATH + LS_COLORS must exist before the
# ---- completion styling below reads them
[ -f ~/.shellrc-lamb ] && . ~/.shellrc-lamb

# ---- history ----
HISTSIZE=100000
SAVEHIST=100000
HISTFILE=~/.zsh_history
setopt SHARE_HISTORY         # share across concurrent sessions (implies appending)
setopt HIST_IGNORE_ALL_DUPS  # a repeated command drops its older copies
setopt HIST_IGNORE_SPACE     # leading space keeps a command out of history
setopt EXTENDED_HISTORY      # record timestamps

# ---- QoL ----
setopt INTERACTIVE_COMMENTS  # allow # comments at the prompt

# Use emacs keybindings even if our EDITOR is set to vi
bindkey -e

# ---- completion ----
zstyle ':completion:*' auto-description 'specify: %d'
zstyle ':completion:*' completer _expand _complete _correct _approximate
zstyle ':completion:*' format 'Completing %d'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' menu select                  # arrow-key navigable menu
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' list-prompt %SAt %p: Hit TAB for more, or the character to insert%s
zstyle ':completion:*' matcher-list '' 'm:{a-z}={A-Z}' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=* l:|=*'
zstyle ':completion:*' select-prompt %SScrolling active: current selection at %p%s
zstyle ':completion:*' use-compctl false
zstyle ':completion:*' verbose true
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'
autoload -Uz compinit
compinit
compdef s=sudo               # complete `s` (alias in shellrc-lamb) like sudo

# ---- pyenv (zsh flavour; the env/PATH half lives in shellrc-lamb) ----
# Guarded: pyenv is a per-machine install; unguarded this errors on every
# shell start on hosts without it.
command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init - zsh)"

# ---- plugins: autosuggestions BEFORE syntax-highlighting ----
source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null

# ---- prompt ----
# Guarded: starship is not packaged on older Debian stable. Without it zsh just
# uses its plain default prompt instead of erroring on every launch.
# (No promptinit/theme here on purpose: zsh prompt themes re-set PS1 in their
# own precmd, clobbering starship and the bad-apple segment.)
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

[ -f ~/.zshbadapple-lamb ] && source ~/.zshbadapple-lamb

# ---- syntax highlighting MUST be sourced LAST ----
# "Last" leans on the sourcing marker block sitting at the END of ~/.zshrc —
# keep it there when programs append below it.
source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null
