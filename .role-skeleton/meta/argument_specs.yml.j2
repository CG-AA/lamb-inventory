---
# Declare every public variable (the {{ role_name }}_* set in defaults/) so
# ansible-core validates types on each run. Internal _-prefixed vars are not
# part of the interface and don't belong here.
argument_specs:
  main:
    short_description: <same one line as meta/main.yml>
    options:
      {{ role_name }}_example:
        type: bool
        default: true
        description: What it does and why the default is right.
